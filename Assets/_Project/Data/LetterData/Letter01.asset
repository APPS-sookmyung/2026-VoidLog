  m_Script: {fileID: 11500000, guid: 37fd52c5d2fcd9940902eff96fa7ef33, type: 3}
  m_Name: Letter01
  m_EditorClassIdentifier: Assembly-CSharp::LetterSO
  letterId: LETTER_01
  senderName: A
  letterTitle: "\uD3B8\uC9C0\uC81C\uBAA9"
  letterContent: "\uC774 \uAE00\uC744 \uC77D\uACE0 \uC788\uB2E4\uBA74, \uC790\uB124\uB3C4
    \uB098\uC640 \uAC19\uC740 \uC790\uB9AC\uC5D0 \uC549\uC544 \uBAA8\uB2C8\uD130\uB9CC
    \uBC14\uB77C\uBCF4\uACE0 \uC788\uB294 \uBD88\uC30D\uD55C \uC601\uD63C\uC774\uACA0\uC9C0.\r\n\uB9E4\uC77C\uAC19\uC774
    \uD3B8\uC9C0\uB4E4\uC744 \uAC80\uC5F4\uD558\uBA70 \uC804\uC1A1\uACFC \uD3D0\uAE30\uB97C
    \uBC18\uBCF5\uD558\uB294 \uC0B6. \uD68C\uC0AC\uAC00 \uAC15\uC870\uD558\uB294
    \u2018\uC5F0\uACB0\uC758 \uAC00\uCE58\u2019\uB294 \uB2E4 \uAC70\uC9D3\uC774\uC57C.
    \uC815\uC791 \uC6B0\uB9AC\uB97C \uC774 \uCC28\uAC00\uC6B4 \uC6B0\uC8FC \uC18D\uC5D0
    \uC644\uBCBD\uD558\uAC8C \uACE0\uB9BD\uC2DC\uCF1C \uB450\uACE0 \uAC10\uC2DC\uD558\uACE0
    \uC788\uC73C\uB2C8\uAE4C. \uD68C\uC0AC\uC758 \uB9D0\uC744 \uBBFF\uB294 \uC560\uC1A1\uC774\uB77C\uBA74
    \uB4A4\uC758 \uAE00\uB4E4\uC740 \uBB34\uC2DC\uD574\uB3C4 \uC88B\uB124.\r\n\uBB34\uD2BC,
    \uB09C \uC774 \uAC10\uC625 \uAC19\uC740 \uACF3\uC744 \uD0C8\uCD9C\uD558\uB824
    \uD574.\r\n\uD0C8\uCD9C \uACC4\uD68D\uC740 \uC138\uC6CC\uB480\uC9C0\uB9CC \uC131\uACF5\uC744
    \uBCF4\uC7A5\uD558\uC9C4 \uBABB\uD558\uACA0\uB124. \uADF8\uB798\uB3C4 \uBBF8\uB798\uC758
    \uD6C4\uBC30\uB4E4\uC744 \uC704\uD574 \uACF3\uACF3\uC5D0 \uD754\uC801\uB4E4\uC744
    \uC228\uACA8\uB193\uB3C4\uB85D \uD558\uC9C0. \uC6B0\uB9AC\uAC00 \uBE44\uB85D
    \uC774 \uBD80\uD488 \uAC19\uC740 \uBC29\uC5D0 \uAC07\uD600\uC788\uC9C0\uB9CC,
    \uAD6D\uB0B4 \uCD5C\uACE0\uC758 \uC5D8\uB9AC\uD2B8\uB85C\uC11C \uACE0\uC6A9\uB41C
    \uC778\uC7AC\uB4E4\uC774\uB2C8 \uC774 \uC815\uB3C4 \uC218\uC900\uC758 \uC218\uC218\uAED8\uB07C\uB294
    \uAC00\uBCCD\uAC8C \uD480 \uC218 \uC788\uC744 \uAC70\uB77C \uBBFF\uC5B4 \uC758\uC2EC\uCE58
    \uC54A\uC544.\r\n\uC9C0\uAE08 \uACE0\uAC1C\uB97C \uB4E4\uC5B4 \uBAA8\uB2C8\uD130\uB97C
    \uBD10. \uC6B0\uB9AC\uB97C \uC5B5\uC555\uD558\uB294 \uC131\uAC00\uC2E0 \uAE08\uAE30
    \uC0AC\uD56D\uB4E4\uC774 \uCCAB \uBC88\uC9F8 \uC5F4\uC1E0\uAC00 \uB420 \uAC70\uB77C\uB124.\r\n\uD1B5\uC81C\uC2E4\uC5D0\uC11C\uB9CC
    \uBCF4\uC774\uB358 \uD589\uC131\uC5D0\uC11C \uB9CC\uB098\uC9C0. \uAC74\uD22C\uB97C
    \uBE48\uB2E4."
