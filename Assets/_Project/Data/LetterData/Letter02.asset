  m_Script: {fileID: 11500000, guid: 37fd52c5d2fcd9940902eff96fa7ef33, type: 3}
  m_Name: Letter02
  m_EditorClassIdentifier: Assembly-CSharp::LetterSO
  letterId: LETTER_01
  senderName: A
  letterTitle: "\uD3B8\uC9C0\uC81C\uBAA9"
  letterContent: "\uD558\uD558, \uC774 \uBB38\uC744 \uADF8\uB0E5 \uC5F4 \uC218 \uC788\uC744
    \uC904 \uC54C\uC558\uB098 \uBCF4\uC9C0? \uC774 \uAE00\uC744 \uC77D\uACE0 \uC788\uB294
    \uAC78 \uBCF4\uB2C8 \uC790\uB124\uB294 \uAF64\uB098 \uC21C\uC9C4\uD55C \uC2E0\uC785\uC774\uAC70\uB098,
    \uC544\uC9C1 \uD68C\uC0AC\uC5D0 \uB35C \uAE38\uB4E4\uC5EC\uC9C4 \uBAA8\uC591\uC774\uAD70.\r\n\r\n\uD5C8\uB465\uC9C0\uB465
    ID \uCE74\uB4DC\uD0A4\uB97C \uCC3E\uC73C\uB824\uACE0 \uC8FC\uBCC0 \uBC14\uB2E5\uC744
    \uC0C5\uC0C5\uC774 \uB4A4\uC84C\uC744 \uC790\uB124 \uBAA8\uC2B5\uC744 \uC0DD\uAC01\uD558\uB2C8
    \uAF64 \uD765\uBBF8\uB85C\uC6CC. \uBBF8\uC548\uD558\uAC8C\uB3C4 \uC6B0\uB9AC
    \uAC19\uC740 \uD3C9\uBC94\uD55C \uC9C1\uC6D0\uB4E4\uC740 \uB4E4\uC5B4\uAC08 \uC218
    \uC5C6\uB2E8\uB2E4. \uB18D\uB2F4\uC740 \uC774\uCBE4 \uD574\uB450\uACE0 \uBCF8\uB860\uC73C\uB85C
    \uB4E4\uC5B4\uAC00\uC9C0.\r\n\r\n\uD2B9\uBCC4\uD55C \uC885\uC774 \uD558\uB098\uB97C
    \uB123\uC5B4\uB480\uC5B4. \uC911\uC559 \uD1B5\uC81C\uC2E4\uB85C \uD5A5\uD558\uB294
    \uBCBD\uC740 \uAD49\uC7A5\uD788 \uD654\uB824\uD558\uC796\uC544? \uD769\uC5B4\uC9C4
    \uC870\uAC01\uB4E4\uC744 \uB611\uBC14\uB85C \uB9DE\uCD94\uBA74 \uBB54\uAC08 \uC5BB\uAC8C
    \uB420\uAC70\uC57C.\r\n\r\n\uC790, \uAD6D\uB0B4 \uCD5C\uACE0 \uC5D8\uB9AC\uD2B8\uC528.
    \uD68C\uC0AC\uC758 \uD654\uB824\uD55C \uAC70\uC9D3\uB9D0\uC5D0 \uB208\uC774 \uBA40\uC5B4
    \uBCBD \uB4A4\uC758 \uC9C4\uC2E4\uC744 \uB193\uCE58\uC9C0 \uB9D0\uB77C\uACE0."
