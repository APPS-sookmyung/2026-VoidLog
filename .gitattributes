# Normalize text files to LF in Git, CRLF in working directory
* text=auto eol=crlf

# Explicitly handle Unity text-based files
*.cs text eol=crlf
*.unity text eol=crlf
*.prefab text eol=crlf
*.asset text eol=crlf
*.meta text eol=crlf
*.asmdef text eol=crlf
*.json text eol=crlf
*.shader text eol=crlf